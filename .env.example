# LLM provider: mock | openai | anthropic | gemini | groq | ollama
LLM_PROVIDER=mock
LLM_MODEL=
# Embeddings: bm25 (offline, default) | sentence-transformers | openai
EMBEDDINGS=bm25
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434
TOP_K=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100
